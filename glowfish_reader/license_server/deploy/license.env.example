# 复制为 /etc/shupai/license.env 并填真值；chmod 600，属主 shupai。
# 切勿入库（含服务器私钥）。

# 服务器私钥（base64）：keygen.py 生成的 server_private.b64 内容
SERVER_PRIV=PUT_SERVER_PRIVATE_B64_HERE

# 账号数据库（SQLite）路径；目录须服务账号可写（见 systemd ReadWritePaths）
# ⚠线上真库是 /var/lib/glowfish/account.db；旧 /var/lib/shupai/license.db 是激活码时代的退役空库，勿再指向
LICENSE_DB=/var/lib/glowfish/account.db

# 应用层限流兜底（每 IP 每窗口请求数 / 窗口秒）。Nginx 再叠一层 limit_req。
LICENSE_RATE_LIMIT=60
LICENSE_RATE_WINDOW=60

# ---- 短信验证码登录（手机号）----------------------------------------------
# 网关：console=开发(验证码只打日志不真发) / aliyun=阿里云短信 Dysmsapi
SMS_PROVIDER=console
# 阿里云短信凭据（SMS_PROVIDER=aliyun 时必填）：建 RAM 子用户，仅授 AliyunDysmsFullAccess
ALIYUN_AK_ID=PUT_RAM_ACCESS_KEY_ID_HERE
ALIYUN_AK_SECRET=PUT_RAM_ACCESS_KEY_SECRET_HERE
ALIYUN_SMS_SIGN=小青鱼阅读器
ALIYUN_SMS_TEMPLATE=SMS_XXXXXXXX
# 防刷（短信费上闸）：同号发码冷却秒 / 同号单日上限 / 验证码有效秒
SMS_SEND_COOLDOWN=60
SMS_DAILY_LIMIT=5
SMS_CODE_TTL=300
